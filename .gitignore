# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/

# Secrets - never commit real values; only *.example files belong in the repo
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Local
node_modules/
tmp/
__pycache__/

# Build output
dist/

# Local Python venv for the webapp-testing skill
.venv/

# Dev-only test vendor (fetched on demand, see README)
tools/vendor/

# Render master. The shipped assets are the WebP exports beside it.
src/assets/scene/crt.png

# Check output. Regenerated by tools/check_room.py and friends on every run.
artifacts/

# Recorded evidence. The PNG sheets in docs/evidence are small and are kept;
# the captures they were reviewed from are megabytes and are reproducible by
# tools/check_audio.py and the journey recording, so they are not committed.
docs/evidence/*.webm
# Reproducible review recordings and raw frames; retained locally for playback.
docs/evidence/refinement/**/*.webm
docs/evidence/refinement/**/*.mp4
docs/evidence/refinement/**/journey-frames/
docs/evidence/refinement/**/journey-concat.txt
